{
	"$schema": "http://json.schemastore.org/tsconfig",
	"extends": "./tooling/typescript/tsconfig.base.json",
	"include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
	"exclude": ["**/dist/**", "**/node_modules/**"],
	"compilerOptions": {
		"composite": false,
		"incremental": false,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"noEmit": true,
		"types": ["node"],
		"rootDir": "."
	}
}
