{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
	"ignorePatterns": [
		"**/node_modules/**",
		".claude/worktrees/**",
		"**/dist/**",
		"**/build/**",
		"**/.tsbuildinfo",
		"**/.pi/**",
		"**/.agents/**",
		"**/.claude/**",
		"**/*.md"
	],
	"plugins": ["typescript", "import", "oxc", "eslint", "unicorn", "node"],
	"jsPlugins": [
		{ "name": "anti-slop", "specifier": "./tooling/oxlint/anti-slop/index.ts" },
		{ "name": "effect", "specifier": "./tooling/oxlint/effect/index.ts" }
	],
	"options": {
		"typeAware": true,
		"typeCheck": false
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"env": {
		"node": true
	},
	"rules": {
		"complexity": "error",
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error",
		"anti-slop/no-react-hooks": "error",
		"anti-slop/no-native-node-modules": "error",
		"anti-slop/no-overzealous-destructuring": "error",
		"anti-slop/no-use-query-outside-loader": "error",
		"anti-slop/no-unsafe-casts": "error",
		"anti-slop/no-coverage-skips": "error",
		"anti-slop/no-test-lifecycle-hooks": "error",
		"anti-slop/no-global-mocks": "error",
		"effect/no-bigint-literals": "error",
		"effect/no-import-from-barrel-package": "error",
		"effect/no-js-extension-imports": "error",
		"effect/no-opaque-instance-fields": "error",
		"effect/no-unused-internal": "error",
		"effecttsgo/any-unknown-in-error-context": "warn",
		"effecttsgo/experimental-api-usage": "off",
		"effecttsgo/unstable-api-usage": "off",
		"effecttsgo/schema-number": "off",
		"effecttsgo/schema-sync-in-effect": "warn",
		"effecttsgo/catch-refail-to-tap-error": "warn",
		"unicorn/consistent-function-scoping": "warn",
		"typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
		"typescript/no-import-type-side-effects": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-unnecessary-type-constraint": "error",
		"typescript/no-useless-empty-export": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-namespace": "error",
		"typescript/no-non-null-assertion": "off",
		"typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
		"import/no-duplicates": "error",
		"import/no-self-import": "error",
		"import/no-empty-named-blocks": "error",
		"eslint/no-console": "error",
		"eslint/no-var": "error",
		"eslint/no-debugger": "error",
		"eslint/no-unused-vars": [
			"error",
			{ "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "fix": { "imports": "safe-fix" } }
		],
		"eslint/prefer-const": "error",
		"eslint/no-useless-constructor": "error",
		"eslint/no-unneeded-ternary": "error",
		"eslint/no-useless-concat": "error",
		"eslint/object-shorthand": "off",
		"eslint/no-shadow": "off",
		"eslint/require-yield": "off",
		"eslint/no-fallthrough": "off",
		"eslint/no-await-in-loop": "off",
		"unicorn/no-abusive-eslint-disable": "error",
		"unicorn/prefer-array-flat-map": "error",
		"oxc/misrefactored-assign-op": "error",
		"oxc/no-map-spread": "off",
		"oxc/no-barrel-file": "off",
		"eslint/no-underscore-dangle": ["error", { "allow": ["_tag"] }]
	},
	"overrides": [
		{
			"files": ["bin/**"],
			"rules": {
				"import/no-unassigned-import": "off",
				"effect/no-js-extension-imports": "off"
			}
		},
		{
			"files": [
				"src/cli.ts",
				"src/claudeGate.ts",
				"src/piExtension.ts",
				"src/gate/HandlerRuntime.ts"
			],
			"rules": {
				"effecttsgo/strict-effect-provide": "off"
			}
		},
		{
			"files": ["scripts/**", "tooling/**"],
			"rules": {
				"eslint/no-console": "off",
				"effect/no-import-from-barrel-package": "off",
				"anti-slop/no-native-node-modules": "off"
			}
		}
	]
}
