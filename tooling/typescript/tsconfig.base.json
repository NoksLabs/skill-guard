{
	"$schema": "https://raw.githubusercontent.com/Effect-TS/tsgo/refs/heads/main/schema.json",
	"include": [],
	"compilerOptions": {
		"outDir": "${configDir}/dist",
		"rootDir": "${configDir}/src",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"exactOptionalPropertyTypes": true,
		"erasableSyntaxOnly": true,
		"moduleDetection": "force",
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"resolveJsonModule": true,
		"pretty": true,
		"skipLibCheck": true,
		"types": [],
		"isolatedModules": true,
		"sourceMap": true,
		"noImplicitReturns": false,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"noEmitOnError": false,
		"noErrorTruncation": false,
		"allowJs": false,
		"checkJs": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noUncheckedIndexedAccess": true,
		"strictNullChecks": true,
		"incremental": true,
		"removeComments": false,
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true,
		"noImplicitOverride": true,
		"stripInternal": false,
		"plugins": [
			{
				"name": "@effect/language-service",
				"refactors": true,
				"includeSuggestionsInTsc": false,
				"quickinfo": true,
				"goto": true,
				"renames": true,
				"ignoreEffectSuggestionsInTscExitCode": true,
				"ignoreEffectWarningsInTscExitCode": false,
				"ignoreEffectErrorsInTscExitCode": false,
				"skipDisabledOptimization": false,
				"importAliases": { "Schema": "S", "Array": "A" },
				"completions": true,
				"diagnostics": true,
				"mermaidProvider": "mermaid.live",
				"noExternal": false,
				"layerGraphFollowDepth": 0,
				"inlays": false,
				"keyPatterns": [
					{ "target": "service", "pattern": "default", "skipLeadingPath": ["src/"] },
					{ "target": "custom", "pattern": "default", "skipLeadingPath": ["src/"] }
				],
				"extendedKeyDetection": false,
				"pipeableMinArgCount": 2,
				"effectFn": ["span"],
				"diagnosticSeverity": {
					"schemaNumber": "off",
					"experimentalApiUsage": "off",
					"unstableApiUsage": "off",
					"preferSchemaOverJson": "error",
					"redundantSchemaTagIdentifier": "error",
					"effectFnOpportunity": "suggestion",
					"anyUnknownInErrorContext": "error",
					"catchAllToMapError": "error",
					"unnecessaryFailYieldableError": "error",
					"catchUnfailableEffect": "error",
					"layerMergeAllWithDependencies": "error",
					"globalErrorInEffectCatch": "error",
					"missingLayerContext": "error",
					"deterministicKeys": "error",
					"classSelfMismatch": "error",
					"effectInVoidSuccess": "error",
					"missingEffectServiceDependency": "error",
					"multipleEffectProvide": "error",
					"scopeInLayerEffect": "error",
					"strictBooleanExpressions": "error",
					"tryCatchInEffectGen": "error",
					"unnecessaryPipeChain": "error",
					"floatingEffect": "error",
					"duplicatePackage": "error",
					"missingEffectContext": "error",
					"missingEffectError": "error",
					"missingStarInYieldEffectGen": "error",
					"unnecessaryEffectGen": "error",
					"missingReturnYieldStar": "error",
					"leakingRequirements": "error",
					"unnecessaryPipe": "error",
					"genericEffectServices": "error",
					"returnEffectInGen": "error"
				},
				"barrelImportPackages": [],
				"namespaceImportPackages": ["effect", "@effect/*"],
				"topLevelNamedReexports": "follow",
				"allowedDuplicatedPackages": [],
				"overrides": [
					{
						"include": ["src/**/*.ts"],
						"options": { "diagnosticSeverity": { "floatingEffect": "error" } }
					}
				]
			}
		]
	}
}
